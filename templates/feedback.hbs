<div class="standard-form" style="gap: .4em">
    <p style="opacity: .8; text-align: center;">{{{localize "map.feedback.intro"}}}</p>

    <p style="opacity: .8; text-align: center; max-width: 400px">{{{localize "map.feedback.discord"}}}</p>

    <p style="opacity: .8; text-align: center; max-width: 400px">{{{localize "map.feedback.helpful"}}}</p>

    <p style="opacity: .8; text-align: center; max-width: 400px">{{{localize "map.feedback.console"}}}</p>

    <fieldset>
        <legend>
        <i class="fa-solid fa-comment-exclamation"></i>{{{localize "map.feedback.legend"}}}</legend>
        <div class="form-group">
            <textarea rows="15" cols="30" name="feedback" style="border: none"></textarea>
        </div>
    </fieldset>

    <footer class="form-footer">
        <button type="submit" class="">
            <i class="fa-solid fa-envelope" inert=""></i>
            <label inert="">{{{localize "map.feedback.send"}}}</label>
        </button>
    </footer>
</div>
